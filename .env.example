# Local development template. Production keys must be unique and independently
# generated for each service; see the Render and production sections in README.
TURA_ENV=development
SECRET_KEY=
TICKET_HMAC_SECRET=
DATABASE_URL=sqlite:///./data/tura.db
# Leave empty for same-origin deployments. Never use a wildcard in production.
CORS_ORIGINS=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
RATE_LIMIT_PER_MINUTE=60
SEAT_LOCK_SECONDS=120
TICKET_VALIDITY_HOURS=72
DEMO_MODE=true
# This must match DEMO_MODE in production, and the demo service must have its
# own database and storage volume.
DEMO_INSTANCE=false
FEATURE_SOS=true
FEATURE_LUGGAGE=true
FEATURE_TRIP_REPLAY=true
FEATURE_I18N=true
DEFAULT_LANGUAGE=en
HOST=127.0.0.1
PORT=8000
